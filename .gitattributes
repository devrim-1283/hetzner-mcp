# Normalise line endings in the working tree so a Windows checkout does not
# produce a diff against a Linux one.
* text=auto eol=lf

# Installer fixtures encode byte-exact expectations. Several of them exist
# specifically to prove that a user's CRLF file survives a write unchanged, so
# git must not normalise them on checkout — doing so would silently convert the
# CRLF cases into LF cases and the assertions would pass while testing nothing.
test/install/adapters/__fixtures__/** -text

# The vendored OpenAPI specs are hashed into src/generated/meta.ts. Rewriting
# their line endings would change those hashes and make `npm run codegen:check`
# fail on a different platform than the one that generated it.
scripts/hetzner-cloud.openapi.json -text
scripts/hetzner-api.openapi.json -text

*.png binary
*.ico binary
